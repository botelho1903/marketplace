# ============================================================
# MARKETPLACE - Environment Variables
# ============================================================
# Copy this file to .env.local (development) or .env.production
# Fill in ALL values before deploying

# ============================================================
# APP CONFIGURATION
# ============================================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# ============================================================
# DATABASE (PostgreSQL)
# ============================================================
# Neon: postgresql://user:pass@ep-xxx.us-east-1.aws.neon.tech/db?sslmode=require
# Supabase: postgresql://postgres:pass@db.xxx.supabase.co:5432/postgres
# Railway: postgresql://postgres:pass@xxx.railway.app:5432/railway
# Local Docker: postgresql://postgres:postgres@localhost:5432/marketplace?schema=public
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/marketplace?schema=public

# ============================================================
# AUTHENTICATION (NextAuth.js)
# ============================================================
# Generate: openssl rand -base64 32
NEXTAUTH_SECRET=your-super-secret-key-min-32-chars-here
NEXTAUTH_URL=http://localhost:3000

# OAuth Providers (Optional - configure in NextAuth config)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ============================================================
# JWT & ENCRYPTION
# ============================================================
# Generate: openssl rand -base64 32 (different from NEXTAUTH_SECRET)
JWT_SECRET=your-jwt-secret-different-from-nextauth-min-32-chars

# Generate: openssl rand -hex 32 (32 chars hex = 64 chars)
ENCRYPTION_KEY=your-32-char-hex-encryption-key-here

# ============================================================
# MERCADO PAGO (Payment Provider)
# ============================================================
# Get from: https://www.mercadopago.com.br/developers/panel
# Sandbox first, then Production

# Production Access Token (starts with APP_USR-)
MERCADO_PAGO_ACCESS_TOKEN=APP_USR-xxxxxxxxxxxxxxxxxxxxxxxxx

# Production Public Key (starts with APP_USR-)
MERCADO_PAGO_PUBLIC_KEY=APP_USR-xxxxxxxxxxxxxxxxxxxxxxxxx

# Webhook Secret (from Mercado Pago webhook config)
MERCADO_PAGO_WEBHOOK_SECRET=your-webhook-secret-from-mercado-pago

# ============================================================
# EMAIL (SMTP)
# ============================================================
# SendGrid: smtp.sendgrid.net / 587 / apikey / YOUR_API_KEY
# Resend: smtp.resend.com / 587 / resend / YOUR_API_KEY
# Mailgun: smtp.mailgun.org / 587 / YOUR_LOGIN / YOUR_PASSWORD
# Postmark: smtp.postmarkapp.com / 587 / YOUR_API_KEY / YOUR_API_KEY
# Local MailHog: localhost / 1025 / / (no auth)

EMAIL_SERVER_HOST=smtp.sendgrid.net
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER=apikey
EMAIL_SERVER_PASSWORD=your-sendgrid-api-key
EMAIL_FROM=noreply@yourdomain.com

# ============================================================
# FILE STORAGE (AWS S3 / Cloudflare R2 / MinIO)
# ============================================================
# AWS S3
AWS_ACCESS_KEY_ID=AKIAxxxxxxxxxxxx
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
AWS_S3_BUCKET=your-bucket-name

# Cloudflare R2 (S3 Compatible)
# AWS_ACCESS_KEY_ID=your-r2-access-key
# AWS_SECRET_ACCESS_KEY=your-r2-secret-key
# AWS_REGION=auto
# AWS_S3_BUCKET=your-r2-bucket
# AWS_S3_ENDPOINT=https://xxx.r2.cloudflarestorage.com

# Local MinIO (Docker)
# AWS_ACCESS_KEY_ID=minioadmin
# AWS_SECRET_ACCESS_KEY=minioadmin
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=marketplace
# AWS_S3_ENDPOINT=http://localhost:9000

# ============================================================
# REDIS (Rate Limiting, Sessions, Cache)
# ============================================================
# Upstash: rediss://user:pass@host:port
# Redis Cloud: redis://user:pass@host:port
# Railway: redis://default:pass@host:port
# Local Docker: redis://localhost:6379
REDIS_URL=redis://localhost:6379

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=900000        # 15 minutes
RATE_LIMIT_MAX_REQUESTS=100        # Max requests per window

# ============================================================
# CAPACITOR (Mobile App)
# ============================================================
# Your deployed Vercel URL (for Capacitor WebView)
CAPACITOR_SERVER_URL=https://your-app.vercel.app

# ============================================================
# OPTIONAL: ANALYTICS & MONITORING
# ============================================================
# Vercel Analytics (auto-enabled on Vercel)
# NEXT_PUBLIC_VERCEL_ANALYTICS_ID=

# Sentry (Error Tracking)
# SENTRY_DSN=
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=

# PostHog (Product Analytics)
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# ============================================================
# OPTIONAL: FEATURE FLAGS
# ============================================================
# Enable/Disable features
ENABLE_PWA=true
ENABLE_PUSH_NOTIFICATIONS=false
ENABLE_ANALYTICS=false
ENABLE_RATE_LIMITING=true
ENABLE_DEBUG_LOGS=false

# ============================================================
# DEVELOPMENT OVERRIDES (Only for local development)
# ============================================================
# DISABLE_IMAGE_OPTIMIZATION=true
# NEXT_TELEMETRY_DISABLED=1