# .dockerignore - Otimiza build Docker excluindo arquivos desnecessários

# Git
.git
.gitignore

# Node modules (serão instalados no container)
node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Next.js
.next
out
build

# Environment files (use .env.production no container)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Logs
logs
*.log

# IDE
.vscode
.idea
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Test coverage
coverage

# Prisma (schema será copiado separadamente)
prisma/migrations

# Docker
Dockerfile
docker-compose.yml
.dockerignore

# Documentation
*.md
!README.md

# Scripts
*.sh
*.bat
*.ps1

# Misc
*.tsbuildinfo
.vercel
.netlify