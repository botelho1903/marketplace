# ============================================================
# MARKETPLACE - Production Environment Variables
# ============================================================
# COPIE ESTE ARQUIVO PARA OS GITHUB SECRETS (Settings → Secrets → Actions)
# Cada linha abaixo = UM SECRET no GitHub
# NÃO COMITE ESTE ARQUIVO COM VALORES REAIS!

# ============================================================
# APP CONFIGURATION
# ============================================================
NEXT_PUBLIC_APP_URL=https://seu-app.vercel.app
NODE_ENV=production

# ============================================================
# DATABASE (PostgreSQL - Neon/Supabase/Railway/PlanetScale/RDS)
# ============================================================
# Formato: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
# Exemplo Neon: postgresql://user:pass@ep-xxx.us-east-1.aws.neon.tech/db?sslmode=require
# Exemplo Supabase: postgresql://postgres:pass@db.xxx.supabase.co:5432/postgres
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require

# ============================================================
# AUTHENTICATION (NextAuth.js)
# ============================================================
# GERE: openssl rand -base64 32
NEXTAUTH_SECRET=COLE_AQUI_O_RESULTADO_DO_OPENSSL_RAND_BASE64_32
NEXTAUTH_URL=https://seu-app.vercel.app

# OAuth Providers (Opcional - configure no painel do provedor)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ============================================================
# JWT & ENCRYPTION (CRÍTICO - NÃO PERCA!)
# ============================================================
# GERE: openssl rand -base64 32 (DIFERENTE do NEXTAUTH_SECRET!)
JWT_SECRET=COLE_AQUI_OUTRO_RESULTADO_DO_OPENSSL_RAND_BASE64_32

# GERE: openssl rand -hex 32 (32 chars hex = 64 caracteres)
# USE PARA CRIPTOGRAFAR DADOS SENSÍVEIS (chaves PIX, tokens, etc.)
ENCRYPTION_KEY=COLE_AQUI_O_RESULTADO_DO_OPENSSL_RAND_HEX_32

# ============================================================
# MERCADO PAGO (PRODUÇÃO - NÃO USE SANDBOX!)
# ============================================================
# Pegue em: https://www.mercadopago.com.br/developers/panel
# Sua aplicação → Credenciais de produção
MERCADO_PAGO_ACCESS_TOKEN=APP_USR-XXXXXXXXXXXXXXXXXXXXXXXXXXXX
MERCADO_PAGO_PUBLIC_KEY=APP_USR-XXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Webhook Secret (configure webhook no painel MP primeiro)
# URL do webhook: https://seu-app.vercel.app/api/webhooks/mercado-pago
# Eventos: payment.created, payment.updated, merchant_order.*
MERCADO_PAGO_WEBHOOK_SECRET=COLE_AQUI_O_SECRET_DO_WEBHOOK_MP

# ============================================================
# EMAIL (SMTP - SendGrid/Resend/Mailgun/Postmark)
# ============================================================
# SendGrid: smtp.sendgrid.net / 587 / apikey / SUA_API_KEY
# Resend: smtp.resend.com / 587 / resend / SUA_API_KEY
# Mailgun: smtp.mailgun.org / 587 / SEU_LOGIN / SUA_SENHA
# Postmark: smtp.postmarkapp.com / 587 / SUA_API_KEY / SUA_API_KEY
EMAIL_SERVER_HOST=smtp.sendgrid.net
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER=apikey
EMAIL_SERVER_PASSWORD=SUA_API_KEY_DO_PROVEDOR_EMAIL
EMAIL_FROM=noreply@seudominio.com

# ============================================================
# FILE STORAGE (AWS S3 / Cloudflare R2 / MinIO)
# ============================================================
# AWS S3
AWS_ACCESS_KEY_ID=AKIAXXXXXXXXXXXX
AWS_SECRET_ACCESS_KEY=SUA_AWS_SECRET_KEY
AWS_REGION=us-east-1
AWS_S3_BUCKET=seu-bucket-name

# ============================================================
# REDIS (Rate Limiting, Sessions, Cache)
# ============================================================
# Upstash: rediss://user:pass@host:port
# Redis Cloud: redis://user:pass@host:port
# Railway: redis://default:pass@host:port
REDIS_URL=rediss://USER:PASSWORD@HOST:PORT

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ============================================================
# CAPACITOR (Mobile App - WebView URL)
# ============================================================
# ATUALIZE APÓS DEPLOY NO VERCEL
CAPACITOR_SERVER_URL=https://seu-app.vercel.app

# ============================================================
# VERCEL DEPLOY (Para GitHub Actions)
# ============================================================
# Token: https://vercel.com/account/tokens
VERCEL_TOKEN=SEU_VERCEL_TOKEN

# Pegue com: vercel inspect https://seu-app.vercel.app
# Verá: orgId e projectId
VERCEL_ORG_ID=SEU_ORG_ID
VERCEL_PROJECT_ID=SEU_PROJECT_ID

# ============================================================
# KEYSTORE PARA APK RELEASE (PLAY STORE)
# ============================================================
# GERE UMA VEZ SÓ E GUARDE PARA SEMPRE!
# SEM ESTE ARQUIVO NÃO CONSEGUE ATUALIZAR APP NA PLAY STORE

# 1. Gere o keystore (PowerShell):
# keytool -genkeypair -alias marketplace -keyalg RSA -keysize 2048 -validity 9125 -keystore marketplace-release.jks -storepass SUA_SENHA -keypass SUA_SENHA -dname "CN=Seu Nome, OU=Dev, O=Sua Empresa, L=Cidade, ST=Estado, C=BR"

# 2. Converta para Base64 (PowerShell):
# [Convert]::ToBase64String([IO.File]::ReadAllBytes("marketplace-release.jks")) | Set-Clipboard

# 3. Cole o Base64 aqui:
KEYSTORE_BASE64=COLE_AQUI_O_BASE64_DO_ARQUIVO_JKS
KEYSTORE_PASSWORD=SUA_SENHA_DO_KEYSTORE
KEY_ALIAS=marketplace
KEY_PASSWORD=SUA_SENHA_DO_KEYSTORE

# ============================================================
# OPTIONAL: ANALYTICS & MONITORING
# ============================================================
# Sentry (Error Tracking)
# SENTRY_DSN=
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=

# PostHog (Product Analytics)
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com