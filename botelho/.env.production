# Production Environment Variables for HTTP Deployment
# Copy this to .env.production and fill in your values

# Database (PostgreSQL)
# For Docker: postgresql://postgres:postgres@db:5432/marketplace?schema=public
# For external DB: postgresql://user:pass@host:5432/dbname?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/marketplace?schema=public"

# NextAuth - USE HTTP URL (not HTTPS)
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-super-secret-key-change-in-production-min-32-chars"

# Email (Nodemailer) - Configure for production
EMAIL_SERVER_HOST="smtp.gmail.com"
EMAIL_SERVER_PORT="587"
EMAIL_SERVER_USER="your-email@gmail.com"
EMAIL_SERVER_PASSWORD="your-app-password"
EMAIL_FROM="Marketplace <noreply@yourdomain.com>"

# SMTP (para reset de senha)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"

# SMS (opcional)
SMS_PROVIDER="mock"
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_SMS_FROM=""
ZENVIA_API_TOKEN=""
ZENVIA_SENDER_ID=""

# Stripe (configure with your keys)
STRIPE_SECRET_KEY="sk_live_..."
STRIPE_PUBLISHABLE_KEY="pk_live_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Mercado Pago (configure with your keys)
MERCADO_PAGO_ACCESS_TOKEN="APP_USR-..."
MERCADO_PAGO_PUBLIC_KEY="APP_USR-..."
MERCADO_PAGO_WEBHOOK_SECRET="..."

# Upload/Storage (AWS S3 or compatible)
AWS_ACCESS_KEY_ID="..."
AWS_SECRET_ACCESS_KEY="..."
AWS_REGION="us-east-1"
AWS_S3_BUCKET="marketplace-uploads"
AWS_S3_URL="http://yourdomain.com/uploads"

# Redis (for caching/sessions)
REDIS_URL="redis://localhost:6379"

# App - USE HTTP URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Marketplace"
NEXT_PUBLIC_DEFAULT_CURRENCY="BRL"
NEXT_PUBLIC_DEFAULT_LOCALE="pt-BR"

# Security
BCRYPT_ROUNDS=12
JWT_SECRET="your-jwt-secret-change-in-production"
JWT_EXPIRES_IN="7d"
REFRESH_TOKEN_EXPIRES_IN="30d"

# Encryption (para dados sensíveis do carrinho guest)
ENCRYPTION_KEY="your-32-char-encryption-key-change-in-production"

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Guest Cart
GUEST_CART_EXPIRY_DAYS=30

# WhatsApp Notifications (opcional)
WHATSAPP_PROVIDER="mock"
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_WHATSAPP_FROM=""
META_WHATSAPP_TOKEN=""
META_WHATSAPP_PHONE_ID=""

# OAuth Providers (configure if using)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""